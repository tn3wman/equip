{
  "name": "equip",
  "version": "1.0.0",
  "description": "Equip coordinates agent skills across your development computers.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"tsx watch --exclude '**/equip-skills-binding-*.mjs' --exclude '.equip-data/**' server/index.ts\" \"vite\"",
    "build": "vite build && npm run build:cli",
    "build:vercel": "tsx scripts/build-vercel.ts",
    "build:cli": "esbuild cli/index.ts --bundle --platform=node --format=cjs --target=node22.20 --external:skills --outfile=dist/equip.cjs",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "cli": "tsx cli/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tn3wman/equip.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/tn3wman/equip/issues"
  },
  "homepage": "https://github.com/tn3wman/equip#readme",
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@vercel/oidc": "^4.0.0",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.50.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "skills": "^1.7.0",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "private": true
}
